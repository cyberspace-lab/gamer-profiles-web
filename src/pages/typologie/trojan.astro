---
import TypologyPage from "~/components/mine/TypologyPage.astro";
import GenericTypologyType from "~/components/mine/GenericTypologyType.astro";
import typologyImage2 from "~/assets/images/typology/trojan/main.png";
import imgSocializer from "~/assets/images/typology/trojan/socializer.png";
import imgCompletionist from "~/assets/images/typology/trojan/completionist.png";
import imgCompetitor from "~/assets/images/typology/trojan/competitor.png";
import imgEscapist from "~/assets/images/typology/trojan/escapist.png";
import imgStoryDriven from "~/assets/images/typology/trojan/story-driven.png";
import imgSmartyPants from "~/assets/images/typology/trojan/smarty-pants.png";
---

<TypologyPage
  typologyName="trojan"
  title="Trojan Typologie"
  heroTitle="Trojan typologie"
  heroImage={typologyImage2}
  ctaTitle="Chcete zjistit svůj profil?"
  ctaSubtitle="Dotazník pro Trojan typologii zatím není k dispozici. Sledujte nás na sociálních sítích a dáme vědět, až bude hotový."
>
  <GenericTypologyType typologyName="trojan" type="socializer" image={imgSocializer} reverse />
  <GenericTypologyType typologyName="trojan" type="completionist" image={imgCompletionist} />
  <GenericTypologyType typologyName="trojan" type="competitor" image={imgCompetitor} reverse />
  <GenericTypologyType typologyName="trojan" type="escapist" image={imgEscapist} />
  <GenericTypologyType typologyName="trojan" type="story-driven" image={imgStoryDriven} reverse />
  <GenericTypologyType typologyName="trojan" type="smarty-pants" image={imgSmartyPants} />
</TypologyPage>
