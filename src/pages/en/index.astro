---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '~/i18n';

import { getPermalink} from '~/utils/permalinks';
import { typology } from '~/navigation';
import psychometricImage from '~/assets/images/psychometrics-1.png';
import typologyImage1 from '~/assets/images/typology-1.png';
import variousControllersImage from '~/assets/images/various_controllers.png';
import brainTypesImage from '~/assets/images/brainTypes.png';

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);

const metadata = {
  title: 'CyberspaceLab - Gaming Typologies',
  ignoreTitleTemplate: true,
};

// Get page content for index with English locale
const indexContent = await getCollection('page-content', ({ id }) => {
  return id.startsWith('en/index/');
});

const sortedIndexContent = indexContent.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    image={{ src: typologyImage1, alt: t('hero.imageAlt') }}
  >
    <Fragment slot="title">
      <span class="block mb-2">{t('hero.gamingTypologies')}</span>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-accent to-secondary animate-float">
        {t('hero.psychologicalTests')}
      </span>
    </Fragment>
    <Fragment slot="subtitle">
      <span class="text-lg md:text-xl text-muted dark:text-slate-300">
        {t('hero.welcome')}
      </span>
    </Fragment>
  </Hero>


  <Content
    isAfterContent
    items={[
      {
        title: t('content.whatAreGamingTypologies'),
        description: `[PLACEHOLDER: English translation needed for gaming typologies introduction]`,
      },
      {
        title: t('content.whatAreTheyGoodFor'),
        description: `[PLACEHOLDER: English translation needed for what gaming typologies are good for]`,
      }
    ]}
    image={{
      src: variousControllersImage,
      alt: t('content.variousTypesAlt'),
    }}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: t('content.whatTypologiesExist'),
        description: `[PLACEHOLDER: English translation needed for what typologies exist]`,
      }
    ]}
    image={{
      src: brainTypesImage,
      alt: t('content.brainTypesAlt'),
    }}
  />

  <section class="mx-auto text-center my-16 px-4 sm:px-6">
    <article class="max-w-4xl mx-auto py-12 rounded-2xl enhanced-card">
      {sortedIndexContent.map(async (entry) => {
        const { Content } = await entry.render();
        return (
          <>
            <header class="mb-8">
              <h2 class="px-4 sm:px-6 text-4xl md:text-5xl font-bold leading-tight text-transparent bg-clip-text bg-gradient-to-r from-primary via-accent to-secondary">
                {entry.data.title}
              </h2>
            </header>
            <div class="px-6 max-w-6xl mx-auto text-xl md:text-1xl text-muted dark:text-slate-400 text-justify">
              <Content />
            </div>
          </>
        );
      })}
    </article>
  </section>

  <Steps
    title={t('steps.howIsTestCreated')}
    items={[
      {
        title: t('steps.step1Title'),
        description: t('steps.step1Desc'),
        icon: 'tabler:package',
      },
      {
        title: t('steps.step2Title'),
        description: t('steps.step2Desc'),
        icon: 'tabler:letter-case',
      },
      {
        title: t('steps.step3Title'),
        description: t('steps.step3Desc'),
        icon: 'tabler:paint',
      },
      {
        title: t('steps.step4Title'),
        description: t('steps.step4Desc'),
        icon: 'tabler:rocket',
      },
      {
        title: t('steps.step5Title'),
        description: t('steps.step5Desc'),
        icon: 'tabler:rocket',
      },
      {
        title: t('steps.step6Title'),
        description: t('steps.step6Desc'),
        icon: 'tabler:rocket',
      },
      {
        title: t('steps.stepDone'),
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: psychometricImage,
      alt: t('steps.stepsImageAlt'),
    }}
  />

  <FAQs
    title={t('faq.title')}
    subtitle={t('faq.subtitle')}
    tagline={t('faq.tagline')}
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '[PLACEHOLDER] Who is behind all this?',
        description: `[PLACEHOLDER: English translation needed for FAQ answer]`
      },
      {
        title: '[PLACEHOLDER] Do I need to register to take the tests?',
        description: `[PLACEHOLDER: English translation needed for FAQ answer]`
      },
      {
        title: "[PLACEHOLDER] What happens to my data when I fill out the questionnaire?",
        description: `[PLACEHOLDER: English translation needed for FAQ answer]`
      },
      {
        title: '[PLACEHOLDER] Can I share the questionnaires?',
        description: `[PLACEHOLDER: English translation needed for FAQ answer]`
      },
      {
        title: '[PLACEHOLDER] Can I use the questionnaires in research?',
        description: `[PLACEHOLDER: English translation needed for FAQ answer]`
      },
      {
        title: "[PLACEHOLDER] Can I participate in the research somehow?",
        description: `[PLACEHOLDER: English translation needed for FAQ answer]`
      }
    ]}
  />
</Layout>
