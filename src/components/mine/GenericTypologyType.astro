---
import TypologyProfile from '~/components/mine/TypologyProfile.astro';
import { getEntry } from 'astro:content';
import { getLangFromUrl } from '~/i18n';

export interface Props {
  typologyName: string; // e.g., "bartle", "hexad", "brainhex", "gain", "trojan"
  type: string; // e.g., "socializer", "killer", etc.
  reverse?: boolean;
  image: any; // Image import
}

const {
  typologyName,
  type,
  reverse = false,
  image,
} = Astro.props;

// Get locale from URL
const locale = getLangFromUrl(Astro.url);

// Get the type entry from content collections with locale-aware path
const typeEntry = await getEntry('typology-types', `${locale}/${typologyName}/${type}`);
if (!typeEntry) {
  throw new Error(`Typology type not found: ${locale}/${typologyName}/${type}`);
}

const { Content } = await typeEntry.render();
---

<TypologyProfile
  type={typeEntry.data.name}
  isReversed={reverse}
  items={[]}
  image={{
    src: image,
    alt: `${typeEntry.data.name} type image`,
  }}
>
  <Content />
</TypologyProfile>
