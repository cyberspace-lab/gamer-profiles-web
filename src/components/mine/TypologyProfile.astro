---
import type { Content } from "~/types";
import Headline from "../ui/Headline.astro";
import WidgetWrapper from "../ui/WidgetWrapper.astro";
import Image from "~/components/common/Image.astro";
import ItemGrid from "../ui/ItemGrid.astro";

export interface Props extends Content {
  type?: string;
}

const {
  type,
  title = await Astro.slots.render("title"),
  subtitle = await Astro.slots.render("subtitle"),
  tagline,
  content = await Astro.slots.render("content"),
  callToAction,
  items = [],
  columns,
  image = await Astro.slots.render("image"),
  isReversed = false,
  isAfterContent = false,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render("bg"),
} = Astro.props;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${isAfterContent ? "pt-0 md:pt-0 lg:pt-0" : ""} ${classes?.container ?? "py-2 md:py-3 lg:py-4"}`}
  bg={bg}
>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: "max-w-xl sm:mx-auto lg:max-w-2xl",
      title:
        "text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading",
      subtitle:
        "max-w-3xl mx-auto sm:text-center text-xl text-muted dark:text-slate-400",
    }}
  />
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div
      class={`flex flex-col md:flex-row ${isReversed ? "md:flex-row-reverse" : ""} md:gap-12 lg:gap-16 items-center`}
    >
      <div class="md:basis-2/3 self-center w-full">
        <div class="mb-4 md:mb-8 text-lg">
          <Fragment slot="content">
            <h2
              class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200"
            >
              {type}
            </h2>
          </Fragment>
        </div>

        <!-- Image appears here on mobile, ordered to show after title -->
        <div aria-hidden="true" class="mb-6 md:hidden">
          {
            image && (
              <div class="relative m-auto max-w-[280px]">
                {typeof image === "string" ? (
                  <Fragment set:html={image} />
                ) : (
                  <Image
                    class="mx-auto w-full typology-image"
                    width={500}
                    height={500}
                    widths={[400, 768]}
                    sizes="(max-width: 768px) 100vw, 432px"
                    layout="responsive"
                    {...(image as any)}
                  />
                )}
              </div>
            )
          }
        </div>

        <div class="mb-8 text-lg">
          <Fragment slot="content">
            <div class="prose prose-lg dark:prose-invert mt-4 text-justify text-muted dark:text-slate-300">
              <slot />
            </div>
          </Fragment>
        </div>
        <ItemGrid
          items={items}
          columns={columns}
          defaultIcon="tabler:check"
          classes={{
            container: `gap-y-4 md:gap-y-8`,
            panel: "max-w-none",
            title:
              "text-lg font-medium leading-6 dark:text-white ml-2 rtl:ml-0 rtl:mr-2",
            description:
              "text-muted dark:text-slate-400 ml-2 rtl:ml-0 rtl:mr-2",
            icon: "flex h-7 w-7 items-center justify-center rounded-full bg-primary dark:text-gray-50 p-1",
            action:
              "text-lg font-medium leading-6 dark:text-white ml-2 rtl:ml-0 rtl:mr-2",
          }}
        />
      </div>

      <!-- Image appears here on tablet/desktop -->
      <div aria-hidden="true" class="hidden md:block md:mt-0 md:basis-1/3">
        {
          image && (
            <div class="relative m-auto max-w-xs">
              {typeof image === "string" ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="mx-auto w-full typology-image"
                  width={500}
                  height={500}
                  widths={[400, 768]}
                  sizes="(max-width: 768px) 100vw, 432px"
                  layout="responsive"
                  {...(image as any)}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</WidgetWrapper>

<style>
  /* Choose one of the three options below by uncommenting */

  /* OPTION 1: Clean, minimal - no border, subtle shadow */
  .typology-image {
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .typology-image:hover {
    transform: scale(1.03);
  }

  /* OPTION 2: Fade edges into background (uncomment to use)
  .typology-image {
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
    transition: transform 0.3s ease;
  }
  .typology-image:hover {
    transform: scale(1.05);
  }
  */

  /* OPTION 3: Soft glow effect (uncomment to use)
  .typology-image {
    filter: drop-shadow(0 0 30px rgba(147, 197, 253, 0.3));
    transition: all 0.3s ease;
  }
  .typology-image:hover {
    filter: drop-shadow(0 0 40px rgba(147, 197, 253, 0.5));
    transform: scale(1.03);
  }
  */
</style>
