---
import type { Content } from "~/types";
import WidgetWrapper from "../ui/WidgetWrapper.astro";
import Image from "~/components/common/Image.astro";
import ItemGrid from "../ui/ItemGrid.astro";

export interface Props extends Content {
  type?: string;
}

const {
  type,
  tagline,
  items = [],
  columns,
  image = await Astro.slots.render("image"),
  isReversed = false,
  isAfterContent = false,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render("bg"),
} = Astro.props;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${isAfterContent ? "pt-0 md:pt-0 lg:pt-0" : ""} ${classes?.container ?? "py-4 md:py-6 lg:py-8"}`}
  bg={bg}
>
  <div class:list={["csl-typology-profile", { reversed: isReversed }]}>

    <!-- Text side -->
    <div class="csl-typology-body">
      {tagline && (
        <p class="eyebrow" style="margin-bottom: 10px">{tagline}</p>
      )}

      {type && (
        <h2 class="csl-typology-name">{type}</h2>
      )}

      <!-- Mobile image -->
      {image && (
        <div class="csl-typology-img-mobile" aria-hidden="true">
          {typeof image === "string" ? (
            <Fragment set:html={image} />
          ) : (
            <Image
              class="typology-image"
              width={280}
              height={280}
              widths={[280, 400]}
              sizes="280px"
              layout="responsive"
              {...(image as any)}
            />
          )}
        </div>
      )}

      <div class="csl-typology-content prose prose-lg dark:prose-invert">
        <slot />
      </div>

      {items?.length > 0 && (
        <ItemGrid
          items={items}
          columns={columns}
          defaultIcon="tabler:check"
          classes={{
            container: "gap-y-4 md:gap-y-6 mt-6",
            panel: "max-w-none",
            title: "text-base font-semibold dark:text-white ml-2",
            description: "text-muted dark:text-slate-400 ml-2",
            icon: "flex h-6 w-6 items-center justify-center rounded-none bg-transparent border border-[var(--csl-cyan)] text-[var(--csl-cyan)] p-0.5 flex-shrink-0",
            action: "text-base font-medium ml-2",
          }}
        />
      )}
    </div>

    <!-- Desktop image -->
    {image && (
      <div class="csl-typology-img-desktop" aria-hidden="true">
        <div class="csl-typology-img-wrap panel notched">
          {typeof image === "string" ? (
            <Fragment set:html={image} />
          ) : (
            <Image
              class="typology-image csl-typology-img"
              width={400}
              height={400}
              widths={[280, 400, 600]}
              sizes="(max-width: 768px) 280px, 400px"
              layout="responsive"
              {...(image as any)}
            />
          )}
        </div>
      </div>
    )}
  </div>
</WidgetWrapper>

<style>
  .csl-typology-profile {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 768px) {
    .csl-typology-profile {
      flex-direction: row;
      gap: 64px;
      align-items: flex-start;
    }
    .csl-typology-profile.reversed {
      flex-direction: row-reverse;
    }
  }

  .csl-typology-body {
    flex: 1 1 0;
    min-width: 0;
  }

  .csl-typology-name {
    font-family: 'Chakra Petch', system-ui, sans-serif;
    font-size: clamp(26px, 4vw, 40px);
    font-weight: 700;
    color: var(--csl-fg-1);
    letter-spacing: 0.01em;
    margin: 0 0 16px;
    line-height: 1.1;
  }

  /* Accent bar under name */
  .csl-typology-name::after {
    content: "";
    display: block;
    width: 56px;
    height: 2px;
    background: var(--csl-grad-signature);
    margin-top: 10px;
  }

  .csl-typology-content {
    color: var(--csl-fg-2);
  }
  .csl-typology-content :global(p) {
    color: var(--csl-fg-2);
    line-height: 1.6;
    text-align: justify;
    margin-top: 0;
  }
  .csl-typology-content :global(strong) {
    color: var(--csl-cyan);
  }
  .csl-typology-content :global(a) {
    color: var(--csl-cyan);
  }

  /* Mobile image: shown inline between title and content */
  .csl-typology-img-mobile {
    display: block;
    margin: 16px auto 20px;
    max-width: 220px;
  }
  @media (min-width: 768px) {
    .csl-typology-img-mobile {
      display: none;
    }
  }

  /* Desktop image: right column with notched panel */
  .csl-typology-img-desktop {
    flex: 0 0 280px;
    width: 280px;
    display: none;
  }
  @media (min-width: 768px) {
    .csl-typology-img-desktop {
      display: block;
    }
  }

  .csl-typology-img-wrap {
    /* panel + notched from global styles */
    padding: 0;
    overflow: hidden;
  }

  .csl-typology-img {
    width: 100%;
    display: block;
    filter: saturate(1.1);
    transition: filter 0.3s ease, transform 0.3s ease;
  }
  .csl-typology-img:hover {
    filter: saturate(1.25) drop-shadow(0 0 18px rgba(0,240,255,0.4));
    transform: scale(1.02);
  }
</style>
