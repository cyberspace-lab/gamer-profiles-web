---
import { Icon } from 'astro-icon/components';
import { SITE } from '~/utils/config';
import { getHomePermalink } from '~/utils/permalinks';
import Logo from '~/components/Logo.astro';
import medisOnLogo from '~/assets/images/partners/medis-on-logo.png';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  dedication?: string;
  dedicationLabel?: string;
  dedicationLogoAlt?: string;
  fundingLogoSrc?: string;
  fundingLogoAlt?: string;
  theme?: string;
}

const {
  socialLinks = [],
  secondaryLinks = [],
  links = [],
  dedication,
  dedicationLabel,
  dedicationLogoAlt,
  fundingLogoSrc,
  fundingLogoAlt,
  theme = 'light',
} = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'csl-footer not-prose']}>
  <div class="csl-footer-inner">
    <!-- Brand column -->
    <div class="csl-footer-brand">
      <a href={getHomePermalink()} class="csl-footer-logo-link">
        <Logo />
      </a>
      <p class="csl-footer-tagline">
        {'Gaming profiles and psychological typologies — research by CyberspaceLab.'}
      </p>
      {secondaryLinks?.length > 0 && (
        <div class="csl-footer-secondary">
          {secondaryLinks.map(({ text, href }) => (
            <a class="csl-footer-link-sm" href={href} set:html={text} />
          ))}
        </div>
      )}

      {socialLinks?.length > 0 && (
        <div class="csl-footer-social-row">
          {socialLinks.map(({ ariaLabel, href, icon }) => (
            <a class="csl-footer-social-icon" href={href} aria-label={ariaLabel}>
              {icon && <Icon name={icon} class="w-4 h-4" />}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Link columns -->
    {links.map(({ title, links: colLinks }) => (
      <div class="csl-footer-col">
        {title && <div class="eyebrow" style="margin-bottom: 12px">{title}</div>}
        {colLinks?.length > 0 && (
          <ul class="csl-footer-list">
            {colLinks.map(({ text, href, ariaLabel }) => (
              <li>
                <a class="csl-footer-link" href={href} aria-label={ariaLabel}>
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>

  {dedication && (
    <div class="csl-footer-dedication" aria-label={dedicationLabel}>
      <div class="csl-footer-dedication-logos">
        {fundingLogoSrc && <img src={fundingLogoSrc} alt={fundingLogoAlt} class="csl-footer-funding-logo" loading="lazy" />}
        <img src={medisOnLogo.src} alt={dedicationLogoAlt} class="csl-footer-dedication-logo" loading="lazy" />
      </div>
      <p class="csl-footer-dedication-text">{dedication}</p>
    </div>
  )}

  <!-- Bottom bar -->
  <div class="csl-footer-bottom">
    <span class="csl-footer-mono">
      © {new Date().getFullYear()} · {SITE?.name ?? 'GamerProfiles'} · ALL RIGHTS RESERVED
    </span>
    <span class="csl-footer-mono" style="color: var(--csl-fg-3)">
      BUILT IN PRAGUE · WIRED IN NEON
    </span>
  </div>
</footer>

<style>
  .csl-footer {
    position: relative;
    border-top: 1px solid var(--csl-line);
    background: var(--csl-bg-subtle);
    padding-top: 64px;
    margin-top: 80px;
  }

  /* footer bg is driven by tokens, no separate override needed */

  .csl-footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 48px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .csl-footer-logo-link {
    display: inline-flex;
    margin-bottom: 14px;
    border-bottom: none;
  }
  .csl-footer-logo-link:hover {
    border-bottom: none;
  }

  .csl-footer-tagline {
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-size: 14px;
    color: var(--csl-fg-3);
    max-width: 38ch;
    margin: 0;
    line-height: 1.5;
  }

  .csl-footer-secondary {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .csl-footer-social-row {
    margin-top: 20px;
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .csl-footer-social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--csl-fg-3);
    border: 1px solid var(--csl-line);
    border-bottom: none;
    transition: color var(--csl-dur-2, 220ms) ease, border-color var(--csl-dur-2, 220ms) ease;
  }
  .csl-footer-social-icon:hover {
    color: var(--csl-cyan);
    border-color: var(--csl-cyan);
  }
  .csl-footer-link-sm {
    font-size: 12px;
    color: var(--csl-fg-4);
    border-bottom: none;
  }
  .csl-footer-link-sm:hover {
    color: var(--csl-cyan);
    border-bottom: none;
  }

  .csl-footer-col {
    display: flex;
    flex-direction: column;
  }

  .csl-footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .csl-footer-link {
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-size: 15px;
    color: var(--csl-fg-2);
    border-bottom: 1px solid transparent;
    width: fit-content;
    transition: color var(--csl-dur-2, 220ms) ease, border-color var(--csl-dur-2, 220ms) ease;
  }
  .csl-footer-link:hover {
    color: var(--csl-cyan);
    border-bottom-color: var(--csl-cyan);
    text-shadow: none;
  }

  .csl-footer-social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .csl-footer-bottom {
    margin-top: 56px;
    padding: 18px 32px;
    border-top: 1px solid var(--csl-line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 48px;
  }

  .csl-footer-dedication {
    max-width: 1200px;
    margin: 48px auto 0;
    padding: 20px 32px;
    border-top: 1px solid var(--csl-line);
  }

  .csl-footer-dedication-logos {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .csl-footer-funding-logo {
    width: min(100%, 390px);
    height: auto;
  }

  .csl-footer-dedication-logo {
    width: 88px;
    height: auto;
  }

  .csl-footer-dedication-text {
    margin: 16px 0 0;
    max-width: 82ch;
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: var(--csl-fg-2);
  }

  .csl-footer-mono {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--csl-fg-2);
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .csl-footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .csl-footer-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 0 20px;
    }
    .csl-footer-bottom {
      padding: 18px 20px;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .csl-footer-dedication {
      margin-top: 32px;
      padding: 20px;
    }
    .csl-footer-dedication-logos {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
    .csl-footer-funding-logo {
      width: min(100%, 390px);
    }
  }
</style>
