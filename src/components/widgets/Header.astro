---
import { Icon } from "astro-icon/components";
import Logo from "~/components/Logo.astro";
import ToggleTheme from "~/components/common/ToggleTheme.astro";
import ToggleMenu from "~/components/common/ToggleMenu.astro";
import Button from "~/components/ui/Button.astro"
import LanguageSwitcher from "~/components/common/LanguageSwitcher.astro";

import { getHomePermalink } from "~/utils/permalinks";
import { trimSlash, getAsset } from "~/utils/permalinks";
import type { CallToAction } from "~/types";

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface ActionLink extends CallToAction {}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<ActionLink>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = "header",
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = "center",
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    "csl-header top-0 z-40 flex-none mx-auto w-full transition-[opacity] ease-in-out",
  ]}
  {...isSticky ? { "data-aw-sticky-header": true } : {}}
  {...id ? { id } : {}}
>
  <div
    class:list={[
      "csl-header-inner",
      { "max-w-[1280px]": !isFullWidth },
    ]}
  >
    <a class="csl-logo" href={getHomePermalink()}>
      <Logo />
    </a>

    <div class="flex items-center md:hidden ml-auto gap-3">
      {showToggleTheme && <ToggleTheme iconClass="w-5 h-5" />}
      <ToggleMenu />
    </div>

    <nav
      class="csl-main-nav items-center w-full md:w-auto hidden md:flex overflow-y-auto overflow-x-hidden md:overflow-visible"
      aria-label="Main navigation"
    >
      <ul class="flex flex-col md:flex-row md:self-center w-full md:w-auto gap-1 md:gap-0">
        {
          links.map(({ text, href, links }) => (
            <li class:list={[{ dropdown: links?.length }]}>
              {links?.length ? (
                <>
                  <button class="nav-link px-4 py-3 flex items-center gap-1 bg-transparent border-0 cursor-pointer">
                    {text}
                    <Icon name="tabler:chevron-down" class="w-3 h-3" />
                  </button>
                  <ul class="dropdown-menu md:absolute pl-4 md:pl-0 md:hidden min-w-[200px]">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            "block py-2 px-5 text-sm nav-link whitespace-nowrap",
                            { "aw-link-active": href2 === currentPath }
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    "nav-link px-4 py-3 flex items-center",
                    { "aw-link-active": href === currentPath }
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div
      class:list={[
        { "ml-auto": position === "left" },
        "hidden md:flex items-center gap-2",
      ]}
    >
      <LanguageSwitcher />
      {showToggleTheme && <ToggleTheme iconClass="w-5 h-5" />}
      {showRssFeed && (
        <a
          class="nav-link p-2 flex items-center"
          aria-label="RSS Feed"
          href={getAsset('/rss.xml')}
        >
          <Icon name="tabler:rss" class="w-5 h-5" />
        </a>
      )}
      {actions?.length ? (
        <span class="ml-2">
          {actions.map(({ text, href, target }) => (
            <a
              href={href}
              class="csl-header-action"
              {...(target ? { target, rel: 'noopener noreferrer' } : {})}
            >
              {text}
            </a>
          ))}
        </span>
      ) : ""}
    </div>
  </div>
</header>

<style>
  .csl-header {
    background: color-mix(in srgb, var(--csl-bg) 82%, transparent);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--csl-line);
  }
  /* background is always driven by --csl-bg token, no separate override needed */

  .csl-header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 14px 32px;
    margin: 0 auto;
    width: 100%;
  }

  .csl-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    border-bottom: none;
  }
  .csl-logo:hover {
    border-bottom: none;
  }

  .csl-main-nav {
    margin-left: auto;
  }

  /* Dropdown menu */
  .dropdown-menu {
    background: var(--csl-deep);
    border: 1px solid var(--csl-line);
    border-radius: 0;
    box-shadow: var(--csl-shadow-card);
  }
  .dropdown-menu .nav-link {
    display: block;
    padding: 10px 20px;
    font-size: 11px;
  }
  .dropdown-menu .nav-link:hover {
    background: var(--csl-panel);
  }

  .csl-header-action {
    display: inline-flex;
    align-items: center;
    font-family: 'Chakra Petch', system-ui, sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 9px 20px;
    clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
    background: var(--csl-accent-primary);
    color: #fff;
    border-bottom: none;
    transition: filter var(--csl-dur-2) ease;
    white-space: nowrap;
  }
  .csl-header-action:hover {
    filter: brightness(1.15) saturate(1.1);
    color: #fff;
    border-bottom: none;
    text-shadow: none;
  }

  @media (max-width: 767px) {
    .csl-header-inner {
      padding: 12px 20px;
    }
  }
</style>
