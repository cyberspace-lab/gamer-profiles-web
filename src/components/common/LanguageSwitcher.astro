---
import { languages, getLangFromUrl, getLocalizedPath, removeLocaleFromPath } from '~/i18n';
import type { Locale } from '~/i18n';

const currentLocale = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

// Remove locale prefix to get base path
const basePath = removeLocaleFromPath(currentPath);

// Create language links
const languageLinks = Object.entries(languages).map(([lang, label]) => ({
  lang: lang as Locale,
  label,
  href: getLocalizedPath(basePath, lang as Locale),
  isActive: lang === currentLocale,
}));
---

<div class="csl-lang-switcher">
  {
    languageLinks.map(({ label, href, isActive }) => (
      <a
        href={href}
        data-language-link
        class:list={['csl-lang-btn', { active: isActive }]}
        aria-current={isActive ? 'page' : undefined}
      >
        {label}
      </a>
    ))
  }
</div>

<script>
  // Static result pages read the query in the browser; keep those scores when switching language.
  if (/\/(?:results|typologie)\//.test(window.location.pathname)) {
    document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
      const url = new URL(link.href);
      url.search = window.location.search;
      link.href = url.href;
    });
  }
</script>

<style>
  .csl-lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--csl-bg-raised);
    border: 1px solid var(--csl-line);
    padding: 3px;
  }

  .csl-lang-btn {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    color: var(--csl-fg-3);
    border-bottom: none;
    transition:
      color var(--csl-dur-2) ease,
      background var(--csl-dur-2) ease;
    white-space: nowrap;
  }
  .csl-lang-btn:hover {
    color: var(--csl-fg-1);
    background: var(--csl-line);
    border-bottom: none;
  }
  .csl-lang-btn.active {
    background: var(--csl-accent-primary);
    color: #fff;
  }
</style>
